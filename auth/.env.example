# Must be identical to the JWT_SECRET in every Quarc app's .env (Music, Notes,
# Weather, Translate, Calendar), otherwise tokens issued here won't verify
# there (and vice versa).
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
# Leave blank to auto-generate one on first run (printed once in the logs).
ADMIN_PASSWORD=

# Set to true in production (requires HTTPS in front of this service, e.g. via
# each app's nginx proxying /api/auth/* here over Tailscale HTTPS).
SECURE_COOKIE=true

# How long a login lasts before every Quarc app forces a re-login. Extended
# by sliding renewal while the app is used. Applies to every app sharing this
# service. Don't go above ~400: Chrome/Edge and Chromium-based WebViews
# (Android, Tauri on Windows) cap a cookie's lifetime at 400 days regardless
# of what's requested here, so anything past that is silently truncated.
SESSION_LIFETIME_DAYS=365

# Set to false to stop people creating their own accounts from any app's
# login screen. Admins can still create accounts in Quarc Store → Admin.
ALLOW_REGISTRATION=true

# Nightly backup of every Quarc account (auth.db) into Quarc_Store/backups/
# nightly_YYYY-MM-DD/. Runs after this hour (UTC); keeps this many days.
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=14
