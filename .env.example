# Quarc Store (catalog + web app). The shared login has its own settings in
# auth/.env — including JWT_SECRET, which the Store itself doesn't need.

# Optional. A GitHub token (a fine-grained token with no extra permissions is
# enough for public repos) raises GitHub's API limit from 60 to 5,000
# requests/hour. Without one, the default 15-minute sync of ~9 apps fits
# comfortably under the anonymous limit.
GITHUB_TOKEN=

# Whose GitHub repos the default catalog points at (only used on first start).
GITHUB_OWNER=zekicandemiralay

# Base URL of the Quarc server; the default catalog's web links use it
# (only used on first start — edit links later in Store → Admin → Catalog).
PUBLIC_HOST=https://quarcnet0.tail84500c.ts.net

# How often to check GitHub for new releases (minutes, minimum 5).
SYNC_INTERVAL_MINUTES=15

# Nightly backup of the Store catalog (store.db), into the same
# backups/nightly_YYYY-MM-DD/ folders as the login database.
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=14
